function PPA_SN_ROI_features_v2(subName, mainDir, varargin)
% PPA_SN_ROI_FEATURES_V2  Estrae features rilevanti per selezione ROI TMS.
%
% Features estratte per ogni ROI (scout), per le comparisons:
%   Task vs Rest  |  Task vs Contralateral Task
%
%   - Complessità: SampEn, HFD, PE  (per-trial → Wilcoxon paired)
%   - FOOOF:       Exponent, Offset  (per-trial → Wilcoxon paired)
%   - ERSD:        sync theta/delta, desync alpha/beta (da file BST)
%   - ITPC:        theta↑, alpha↑, beta↓  (gate soglia + Wilcoxon TF per-trial)
%
% Pesi basati su importanza electrode-level (SHAP + mean_rank):
%   sampen=2.0, itpc=1.3, fooof=1.0, ersd_theta/delta=1.0,
%   hfd=0.6, ersd_alpha/beta=0.5, pe=0.5
%
% VARARGIN
%   abilitate         bool    — se false, skip                  (default: true)
%   taskCond          str     — condizione task BST             (default: 'Immagine')
%   restCond          str     — condizione rest BST             (default: 'Rest')
%   scoutsName        str     — tag scout ipsi                  (default: 'SN_scout')
%   contraScoutsName  str     — tag scout contra                (default: 'Contralateral_SN_scout')
%   restScoutsName    str     — tag scout rest                  (default: 'SN_rest_scout')
%   itpcSearch        str     — tag file TF per ITPC            (default: 'for_ITPC')
%   itpcMinVal        float   — soglia gate ITPC                (default: 0.3)
%   compImgRest       str     — nome file comparison ERSD Img vs Rest
%   compImgContra     str     — nome file comparison ERSD Img vs Contra
%   alpha             float   — soglia significatività          (default: 0.05)
%   tRange            [1x2]   — finestra temporale ERSD+ITPC   (default: [0.07 0.15])
%   resultsDir        str     — cartella output                 (default: mainDir/Results)
%   fs                float   — freq campionamento Hz           (default: 256)

%% ====================== VARARGIN MANAGER ================================
% Default parameters
abilitate        = true;
taskCond         = 'Immagine';
restCond         = 'Rest';
scoutsName       = 'SN_scout';
contraScoutsName = 'Contralateral_SN_scout';
restScoutsName   = 'SN_rest_scout';
itpcSearch       = 'for_ITPC';
itpcMinVal       = 0.3;
compImgRest      = 'Comparison_Scouts_ERSD_freqs_Immagine_vs_Rest';
compImgContra    = 'Comparison_Scouts_ERSD_freqs_Immagine_vs_contralateral';
alpha            = 0.05;
tRange           = [0.07, 0.2];
resultsDir       = fullfile(mainDir, 'Results');
fs               = 256;

for i = 1:2:length(varargin)
    switch varargin{i}
        case 'abilitate',        abilitate        = varargin{i+1};
        case 'taskCond',         taskCond         = varargin{i+1};
        case 'restCond',         restCond         = varargin{i+1};
        case 'scoutsName',       scoutsName       = varargin{i+1};
        case 'contraScoutsName', contraScoutsName = varargin{i+1};
        case 'restScoutsName',   restScoutsName   = varargin{i+1};
        case 'compImgRest',      compImgRest      = varargin{i+1};
        case 'compImgContra',    compImgContra    = varargin{i+1};
        case 'itpcSearch',       itpcSearch       = varargin{i+1};
        case 'itpcMinVal',       itpcMinVal       = varargin{i+1};
        case 'alpha',            alpha            = varargin{i+1};
        case 'tRange',           tRange           = varargin{i+1};
        case 'resultsDir',       resultsDir       = varargin{i+1};
        case 'fs',               fs               = varargin{i+1};
    end
end

if ~abilitate
    fprintf('PPA_SN_ROI_features_v2 skipped\n')
    return
end

%% ====================== FEATURE WEIGHTS =================================
% DERIVED FROM SHAP SVM + RF. Expected direction: +1 = Task > Rest.
% -1 = Task < Rest
% Negative score = ROI does not go in the expected direction
featureWeights = struct();
featureWeights.sampen     = struct('w', 2.0, 'dir', -1);  % Task < Rest
featureWeights.hfd        = struct('w', 0.6, 'dir', +1);  % Task > Rest
featureWeights.pe         = struct('w', 0.5, 'dir', -1);  % Task < Rest
featureWeights.fooof_exp  = struct('w', 1.0, 'dir', +1);  % Task > Rest
featureWeights.fooof_off  = struct('w', 1.0, 'dir',  0);  % non directional
featureWeights.ersd_theta = struct('w', 1.0, 'dir', +1);  % sync Task
featureWeights.ersd_delta = struct('w', 1.0, 'dir', +1);  % sync Task
featureWeights.ersd_alpha = struct('w', 0.5, 'dir', -1);  % desync Task
featureWeights.ersd_beta  = struct('w', 0.5, 'dir', -1);  % desync Task
featureWeights.itpc_theta = struct('w', 1.3, 'dir', +1);  % Task > Rest
featureWeights.itpc_alpha = struct('w', 1.3, 'dir', +1);  % Task > Rest
featureWeights.itpc_beta  = struct('w', 1.3, 'dir', -1);  % Task < Rest

%% ================== STEP 1: LOAD SCOUTS TIMESERIES ======================
fprintf('[ROI_features_v2] Loading scouts timeseries for %s...\n', subName)

tsTask   = load_scout_timeseries(subName, taskCond,  scoutsName);
tsRest   = load_scout_timeseries(subName, restCond,  restScoutsName);
tsContra = load_scout_timeseries(subName, taskCond,  contraScoutsName);

roiNames = tsTask.roiNames;
roiNames = rearrange_rowNames(roiNames);
nROI     = numel(roiNames);

%% ====================== STEP 2: COMPLESSITÀ =============================
fprintf('[ROI_features_v2] Computing complexity features...\n')

complexTask   = compute_complexity_allROI(tsTask,   fs);
complexRest   = compute_complexity_allROI(tsRest,   fs);
complexContra = compute_complexity_allROI(tsContra, fs);

%% ====================== STEP 3: FOOOF ===================================
fprintf('[ROI_features_v2] Loading FOOOF features...\n')

fooofTask   = PPA_FOOOF_features(subName, taskCond, 'prefix', 'Scouts');
fooofRest   = PPA_FOOOF_features(subName, restCond, 'prefix', 'Scouts');
fooofContra = PPA_FOOOF_features(subName, taskCond, 'prefix', 'Contralateral_Scouts');

%% ====================== STEP 4: ERSD ====================================
fprintf('[ROI_features_v2] Loading ERSD comparisons...\n')

ersdVsRest   = load_ersd_comp(subName, compImgRest,   tRange, alpha);
ersdVsContra = load_ersd_comp(subName, compImgContra, tRange, alpha);

%% ====================== STEP 5: ITPC ====================================
fprintf('[ROI_features_v2] COmputing ITPC and contrasts...\n')

ITPC = PPA_ITPC(subName, '', 'abilitate', 1, 'cond', taskCond, 'searchQuery', itpcSearch);
ITPC = PPA_extract_significant_ITPCs(ITPC, [4,  8],  'Theta', itpcMinVal);
ITPC = PPA_extract_significant_ITPCs(ITPC, [8,  13], 'Alpha', itpcMinVal);
ITPC = PPA_extract_significant_ITPCs(ITPC, [13, 30], 'Beta',  itpcMinVal);

itpcComp = PPA_ITPC_band_comparison(subName, ITPC, ...
    'taskCond',     taskCond, ...
    'restCond',     restCond, ...
    'taskSearch',   itpcSearch, ...
    'restSearch',   itpcSearch, ...
    'contraSearch', itpcSearch, ...
    'tWin',         tRange, ...
    'alpha',        alpha, ...
    'minITPCvalue', itpcMinVal);

%% ============== STEP 6: WILCOXON FOR COMPLESSITÀ AND FOOOF ==============
fprintf('[ROI_features_v2] Wilcoxon paired for complexity and FOOOF...\n')

compResults_vsRest   = struct();
compResults_vsContra = struct();

for r = 1:nROI
    sName = matlab.lang.makeValidName(roiNames{r});

    % --- Task vs Rest ---
    compResults_vsRest.(sName) = run_wilcoxon_roi( ...
        complexTask.(sName),  complexRest.(sName), ...
        fooofTask.(sName),    fooofRest.(sName), ...
        featureWeights, alpha);

    % --- Task vs Contralateral (bonus-only: no penalty) ---
    if isfield(complexContra, sName) && isfield(fooofContra, sName)
        compResults_vsContra.(sName) = run_wilcoxon_roi( ...
            complexTask.(sName),  complexContra.(sName), ...
            fooofTask.(sName),    fooofContra.(sName), ...
            featureWeights, alpha, true);
    else
        compResults_vsContra.(sName) = empty_wilcoxon_roi();
    end
end

%% ====================== STEP 7: ASSEMBLE FEATURES DFS ===================
featureDefs = {
% Complexity Task vs Rest
'SampEn_VsRest',      compResults_vsRest,   'sampen',    'sig', 'sampen',    featureWeights.sampen.dir;
'HFD_VsRest',         compResults_vsRest,   'hfd',       'sig', 'hfd',       featureWeights.hfd.dir;
'PE_VsRest',          compResults_vsRest,   'pe',        'sig', 'pe',        featureWeights.pe.dir;
% FOOOF Task vs Rest
'FOOOF_Exp_VsRest',   compResults_vsRest,   'fooof_exp', 'sig', 'fooof_exp', featureWeights.fooof_exp.dir;
'FOOOF_Off_VsRest',   compResults_vsRest,   'fooof_off', 'sig', 'fooof_off', featureWeights.fooof_off.dir;
% Complexity Task vs Contra
'SampEn_VsContra',    compResults_vsContra, 'sampen',    'sig', 'sampen',    featureWeights.sampen.dir;
'HFD_VsContra',       compResults_vsContra, 'hfd',       'sig', 'hfd',       featureWeights.hfd.dir;
'PE_VsContra',        compResults_vsContra, 'pe',        'sig', 'pe',        featureWeights.pe.dir;
% FOOOF Task vs Contra
'FOOOF_Exp_VsContra', compResults_vsContra, 'fooof_exp', 'sig', 'fooof_exp', featureWeights.fooof_exp.dir;
'FOOOF_Off_VsContra', compResults_vsContra, 'fooof_off', 'sig', 'fooof_off', featureWeights.fooof_off.dir;
};

itpcDefs = {
'ITPC_Theta_VsRest',    'Theta', 'VsRest',   'itpc_theta', featureWeights.itpc_theta.dir;
'ITPC_Alpha_VsRest',    'Alpha', 'VsRest',   'itpc_alpha', featureWeights.itpc_alpha.dir;
'ITPC_Beta_VsRest',     'Beta',  'VsRest',   'itpc_beta',  featureWeights.itpc_beta.dir;
'ITPC_Theta_VsContra',  'Theta', 'VsContra', 'itpc_theta', featureWeights.itpc_theta.dir;
'ITPC_Alpha_VsContra',  'Alpha', 'VsContra', 'itpc_alpha', featureWeights.itpc_alpha.dir;
'ITPC_Beta_VsContra',   'Beta',  'VsContra', 'itpc_beta',  featureWeights.itpc_beta.dir;
};

%% ====================== STEP 8: RANKING TABLES ==========================
[T_bool, T_detail, T_rank] = build_roi_score_table( ...
    featureDefs, itpcDefs, itpcComp, ersdVsRest, ersdVsContra, roiNames, featureWeights);

disp('=== ROI RANKING ==='); disp(T_rank)

%% ======================= STEP 9: SAVE ===================================
if ~exist(resultsDir, 'dir'), mkdir(resultsDir); end
subDir = fullfile(resultsDir, subName);
if ~exist(subDir, 'dir'), mkdir(subDir); end

writetable(T_bool,   fullfile(subDir, 'ROI_boolean_features.xlsx'), 'WriteRowNames', true);
writetable(T_detail, fullfile(subDir, 'ROI_detailed_features.xlsx'), 'WriteRowNames', true);
writetable(T_rank,   fullfile(subDir, 'ROI_ranked.xlsx'), 'WriteRowNames', true);

allResults = struct();
allResults.compResults_vsRest   = compResults_vsRest;
allResults.compResults_vsContra = compResults_vsContra;
allResults.ersdVsRest           = ersdVsRest;
allResults.ersdVsContra         = ersdVsContra;
allResults.ITPC                 = ITPC;
allResults.itpcComp             = itpcComp;
allResults.T_bool               = T_bool;
allResults.T_detail             = T_detail;
allResults.T_rank               = T_rank;

matPath = fullfile(subDir, 'ROI_features.mat');
save(matPath, 'allResults');
fprintf('[ROI_features_v2] Results saved in %s\n', subDir)

end


%% ========================================================================
%                           LOCAL FUNCTIONS
%% ========================================================================

function ts = load_scout_timeseries(subName, cond, tag)
% Load all matrix files (scout timeseries) per-trial.
    files = bst_process('CallProcess', 'process_select_files_matrix', [], [], ...
        'subjectname',   subName, ...
        'condition',     cond, ...
        'tag',           tag, ...
        'includebad',    0, ...
        'includeintra',  0, ...
        'includecommon', 0, ...
        'outprocesstab', 'no');
    files(~cellfun(@(c) strncmp(c, [tag ' '], length(tag)+1), {files.Comment})) = [];

    assert(~isempty(files), 'Nessun file scout trovato: sub=%s cond=%s tag=%s', ...
        subName, cond, tag);

    tmp      = in_bst_data(files(1).FileName);
    nSamples = size(tmp.Value, 2);
    roiNames = rearrange_rowNames(tmp.Description);
    nROI     = numel(roiNames);
    nTrials  = numel(files);

    ts.roiNames = roiNames;
    for r = 1:nROI
        sName      = matlab.lang.makeValidName(roiNames{r});
        ts.(sName) = nan(nTrials, nSamples);
    end

    for t = 1:nTrials
        d = in_bst_data(files(t).FileName);
        for r = 1:nROI
            sName           = matlab.lang.makeValidName(roiNames{r});
            ts.(sName)(t,:) = d.Value(r, :);
        end
    end
end


function cx = compute_complexity_allROI(ts, fs)
% Call PPA_complexity_features for each ROI in ts struct.
    cx = struct();
    roiNames = ts.roiNames;
    for r = 1:numel(roiNames)
        sName      = matlab.lang.makeValidName(roiNames{r});
        cx.(sName) = PPA_complexity_features(ts.(sName), fs);
    end
end


function ersdComp = load_ersd_comp(subName, compName, tRange, alpha)
% Load ERSD comparison file from BST and re-structure it per-ROI and band
    compFile = find_presults_bst(subName, compName, 1, 'timefreq');
    if isempty(compFile)
        warning('load_ersd_comp: comparison not found — %s', compName);
        ersdComp = struct();
        return
    end
    compStruct = in_bst_data(compFile{1});
    ersdComp   = extract_ersd_per_roi(compStruct, tRange, alpha);
end


function res = extract_ersd_per_roi(compStruct, tRange, alpha)
% For each ROI and band, extract: sig, dirMatch, persistence, dirSign.
    expectedDir      = struct('delta',+1,'theta',+1,'alpha',-1,'beta',-1,'gamma1',-1);
    defaultBandNames = {'delta','theta','alpha','beta','gamma1'};
    defaultBandLims  = [1,4; 5,7; 8,14; 14,30; 31,45];

    freqs   = compStruct.Freqs;
    timeVec = compStruct.Time;
    tMask   = timeVec >= tRange(1) & timeVec <= tRange(2);
    assert(any(tMask), 'No sample in tRange [%.3f, %.3f]', tRange(1), tRange(2));

    pmap     = compStruct.pmap;
    tmap     = compStruct.tmap;
    rowNames = rearrange_rowNames(compStruct.RowNames);
    nROI     = size(pmap, 1);
    res      = struct();

    if iscell(freqs) && size(freqs, 2) >= 2
        isBanded  = true;
        bandNames = freqs(:, 1)';
        nBands    = numel(bandNames);
    else
        isBanded  = false;
        freqVec   = freqs;
        bandNames = defaultBandNames;
        nBands    = numel(bandNames);
    end

    for r = 1:nROI
        sName = matlab.lang.makeValidName(rowNames{r});
        for b = 1:nBands
            bName = bandNames{b};
            if isBanded
                p_slice = squeeze(pmap(r, tMask, b));
                t_slice = squeeze(tmap(r, tMask, b));
            else
                fIdx = freqVec >= defaultBandLims(b,1) & freqVec <= defaultBandLims(b,2);
                if ~any(fIdx), continue; end
                p_slice = squeeze(pmap(r, tMask, fIdx));
                t_slice = squeeze(tmap(r, tMask, fIdx));
            end

            minP        = min(p_slice(:));
            isSig       = minP < alpha;
            meanT       = mean(t_slice(:));
            obsDir      = sign(meanT);
            expD        = expectedDir.(bName);
            dirMatch    = isSig && (obsDir == expD || expD == 0);
            persistence = mean(p_slice(:) < alpha);

            res.(sName).(bName).sig         = isSig;
            res.(sName).(bName).dirMatch    = dirMatch;
            res.(sName).(bName).persistence = persistence;
            res.(sName).(bName).dirSign     = obsDir;
            res.(sName).(bName).meanT       = meanT;
        end
    end
end


function wRes = run_wilcoxon_roi(cxA, cxB, fooofA, fooofB, fw, alpha, isBonus)
% Wilcoxon signed-rank paired for complessità and FOOOF.
% isBonus=true: VsContra modality (score never negative).
    if nargin < 7, isBonus = false; end
    featList  = {'sampen','hfd','pe'};
    fooofList = {'fooof_exp','fooof_off'};
    srcFooof  = {'exponent','offset'};
    wRes      = struct();

    for f = 1:numel(featList)
        fn        = featList{f};
        wRes.(fn) = wilcoxon_entry(cxA.(fn), cxB.(fn), fw.(fn).dir, alpha, isBonus);
    end
    for f = 1:numel(fooofList)
        fn        = fooofList{f};
        wRes.(fn) = wilcoxon_entry(fooofA.(srcFooof{f}), fooofB.(srcFooof{f}), fw.(fn).dir, alpha, isBonus);
    end
end


function entry = wilcoxon_entry(a, b, expectedDir, alpha, isBonus)
% Cpmpute Wilcoxon paired, sig, direction and scoreSign.
% isBonus=true: modality bonus-only (VsContra) — scoreSign never negative.
    if nargin < 5, isBonus = false; end
    n        = min(numel(a), numel(b));
    a        = a(1:n);  b = b(1:n);
    validIdx = ~isnan(a) & ~isnan(b);

    if sum(validIdx) < 5
        entry = struct('p', NaN, 'sig', false, 'medianDiff', NaN, ...
                       'obsDir', 0, 'dirMatch', false, 'scoreSign', 0);
        return
    end

    [p, ~]  = signrank(a(validIdx), b(validIdx));
    medDiff = median(a(validIdx) - b(validIdx));
    obsDir  = sign(medDiff);
    isSig   = p < alpha;

    if expectedDir == 0
        dirMatch  = isSig;
        scoreSign = double(isSig);
    else
        dirMatch  = isSig && (obsDir == expectedDir);
        if isSig
            if isBonus
                % VsContra: bonus se direzione corretta, NaN (0) altrimenti
                scoreSign = double(obsDir == expectedDir);
            else
                scoreSign = double(obsDir == expectedDir) * 2 - 1;
            end
        else
            scoreSign = 0;
        end
    end

    entry = struct('p', p, 'sig', isSig, 'medianDiff', medDiff, ...
                   'obsDir', obsDir, 'dirMatch', dirMatch, 'scoreSign', scoreSign);
end


function entry = empty_wilcoxon_roi()
% Empty struct for absent contralateral ROI
    featList = {'sampen','hfd','pe','fooof_exp','fooof_off'};
    entry    = struct();
    for f = 1:numel(featList)
        entry.(featList{f}) = struct('p', NaN, 'sig', false, 'medianDiff', NaN, ...
                                     'obsDir', 0, 'dirMatch', false, 'scoreSign', 0);
    end
end


function [T_bool, T_detail, T_rank] = build_roi_score_table( ...
        featureDefs, itpcDefs, itpcComp, ersdVsRest, ersdVsContra, roiNames, fw)
% Assemble 3 output tables.
% Score = fw.w * scoreSign * rank_weight
% rank_weight = (k - rank + 1) / N  between signficative ROI for the
% feature

    MAX_SCORE = 10;
    N         = numel(roiNames);
    ersdBands = {'delta','theta','alpha','beta'};
    allScores = {};  % {roiName, label, isSig, orderVal, weight, scoreSign}

    for r = 1:N
        sName = matlab.lang.makeValidName(roiNames{r});

        %% --- Wilcoxon: complexity + FOOOF ---
        for d = 1:size(featureDefs,1)
            label    = featureDefs{d,1};
            compData = featureDefs{d,2};
            field    = featureDefs{d,3};
            wKey     = featureDefs{d,5};

            if ~isfield(compData, sName), continue; end
            entry     = compData.(sName).(field);
            w         = fw.(wKey).w;
            isSig     = entry.sig;
            orderVal  = abs(entry.medianDiff);
            scoreSign = entry.scoreSign;
            allScores(end+1,:) = {sName, label, isSig, orderVal, w, scoreSign}; %#ok<AGROW>
        end

        %% --- ERSD vs Rest ---
        if isfield(ersdVsRest, sName)
            for b = 1:numel(ersdBands)
                bName = ersdBands{b};
                wKey  = ['ersd_' bName];
                if ~isfield(fw, wKey) || ~isfield(ersdVsRest.(sName), bName), continue; end
                entry    = ersdVsRest.(sName).(bName);
                w        = fw.(wKey).w;
                expD     = fw.(wKey).dir;
                isSig    = entry.sig;
                orderVal = entry.persistence;
                sSign    = double(isSig) * (double(entry.dirSign == expD || expD == 0)*2 - 1);
                allScores(end+1,:) = {sName, ['ERSD_' bName '_VsRest'], isSig, orderVal, w, sSign}; %#ok<AGROW>
            end
        end

        %% --- ERSD vs Contra (bonus-only: no prenalty) ---
        if isfield(ersdVsContra, sName)
            for b = 1:numel(ersdBands)
                bName = ersdBands{b};
                wKey  = ['ersd_' bName];
                if ~isfield(fw, wKey) || ~isfield(ersdVsContra.(sName), bName), continue; end
                entry    = ersdVsContra.(sName).(bName);
                w        = fw.(wKey).w;
                expD     = fw.(wKey).dir;
                isSig    = entry.sig;
                orderVal = entry.persistence;
                % Bonus-only: +1 if sig and direction are both correct 0
                % otherwise
                sSign    = double(isSig && (entry.dirSign == expD || expD == 0));
                allScores(end+1,:) = {sName, ['ERSD_' bName '_VsContra'], isSig, orderVal, w, sSign}; %#ok<AGROW>
            end
        end

        %% --- ITPC (gated + Wilcoxon TF per-trial) ---
        if ~isempty(itpcComp) && isfield(itpcComp, sName)
            for d = 1:size(itpcDefs,1)
                label    = itpcDefs{d,1};
                bName    = itpcDefs{d,2};
                compType = itpcDefs{d,3};
                wKey     = itpcDefs{d,4};
                expD     = itpcDefs{d,5};

                if ~isfield(itpcComp.(sName), bName), continue; end
                bandData = itpcComp.(sName).(bName);
                if ~bandData.gatePass, continue; end
                if ~isfield(bandData, compType), continue; end

                entry    = bandData.(compType);
                isSig    = entry.sig;
                orderVal = abs(entry.medDiff);
                w        = fw.(wKey).w;
                isContraComp = contains(compType, 'Contra');
                if isSig
                    if isContraComp
                        % Bonus-only: +1 if sig and direction are both correct 0
                        % otherwise
                        sSign = double(entry.obsDir == expD || expD == 0);
                    else
                        sSign = double(entry.obsDir == expD || expD == 0)*2 - 1;
                    end
                else
                    sSign = 0;
                end
                allScores(end+1,:) = {sName, label, isSig, orderVal, w, sSign}; %#ok<AGROW>
            end
        end
    end

    if isempty(allScores)
        T_bool = table(); T_detail = table(); T_rank = table();
        return
    end

    %% Assemble matrices
    allElems = unique(allScores(:,1), 'stable');
    allCols  = unique(allScores(:,2), 'stable');
    nE = numel(allElems);
    nC = numel(allCols);

    binMat   = false(nE, nC);
    orderMat = zeros(nE, nC);
    wMat     = ones(nE,  nC);
    signMat  = zeros(nE, nC);

    for row = 1:size(allScores,1)
        ei = strcmp(allElems, allScores{row,1});
        ci = strcmp(allCols,  allScores{row,2});
        binMat(ei, ci)   = allScores{row,6} == 1;
        orderMat(ei, ci) = allScores{row,4};
        wMat(ei, ci)     = allScores{row,5};
        signMat(ei, ci)  = allScores{row,6};
    end

    %% Ranked score per column
    scoreMat = zeros(nE, nC);
    for ci = 1:nC
        exprMask = binMat(:, ci);
        k        = sum(exprMask);
        if k == 0, continue; end
        exprIdx  = find(exprMask);
        [~, ord] = sort(orderMat(exprIdx, ci), 'descend');
        for rank = 1:k
            ri  = exprIdx(ord(rank));
            scoreMat(ri, ci) = signMat(ri,ci) * wMat(ri,ci) * MAX_SCORE * (k - rank + 1) / N;
        end
    end

    %% Output tables
    T_bool = array2table(binMat, 'VariableNames', allCols, 'RowNames', allElems);

    scoreNaN = scoreMat;
    scoreNaN(~binMat) = NaN;
    T_detail = array2table(scoreNaN, 'VariableNames', allCols, 'RowNames', allElems);

    nFeat      = sum(binMat, 2);
    totalScore = sum(scoreMat, 2);
    [~, idx]   = sortrows(totalScore, 'descend');
    T_rank = table(allElems(idx), nFeat(idx), totalScore(idx), ...
        'VariableNames', {'ROI', 'nFeatures', 'TotalScore'});
end


function roiNames = rearrange_rowNames(roiNames)
% Normalize ROI names: remove ' @ scout', suffissi ' L' and ' R'.
% Normalizza i nomi ROI: rimuove ' @ scout', suffissi ' L' e ' R'.
    roiNames = split(roiNames, ' @', 2);
    roiNames = roiNames(:, 1);
    for r = 1:numel(roiNames)
        currR = roiNames{r};
        if endsWith(currR, ' R')
            tmp = split(currR, ' R'); roiNames{r} = tmp{1};
        elseif endsWith(currR, ' L')
            tmp = split(currR, ' L'); roiNames{r} = tmp{1};
        end
    end
end