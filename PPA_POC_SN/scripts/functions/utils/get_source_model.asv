function sourceFile = get_source_model(cond, sub,searchQuery)

%% ========================== VARAGIN MANAGER =============================
if nargin < 1
    error('Lanciata la funzione senza alcuna variabile')
end

if isempty(cond)
    error('Nessuna condizione selezioanta')
end

if isempty(sub)
    subStruct = bst_get('Subject');
    sub = subStruct.Name;
end

%% ========================== MAIN ========================================
if nargin < 3
    searchQuery = 'dSPM';
    protocolInfo = bst_get('ProtocolInfo');
    dataDir = protocolInfo.STUDIES;
    subFolder = fullfile(dataDir, sub, cond);
    sFiles = dir(subFolder);
    sFiles = sFiles(contains({sFiles.name}, searchQuery));
    if numel(sFiles) > 1
        sprintf(['Trovati più modelli di sorgenti per il soggetto %s. ' ...
            'Selezionare una search query a lancio della funzione. '], sub)
    end

else
    sFiles = bst_process('CallProcess', 'process_select_files_results', [], [], ...
        'subjectname',   sub, ...
        'condition',     cond, ...
        'tag',           searchQuery, ...
        'includebad',    0, ...
        'includeintra',  0, ...
        'includecommon', 0, ...
        'outprocesstab', 'no');  % No
    if numel(sFiles) > 1
        sprintf(['Trovati più modelli con la stessa search query per il soggetto %s. ' ...
            'Provare con una nuova search query'], sub)
        sourceFile = [];
    elseif numer(sFiles) == 1
        sourceFile
    end
end



end